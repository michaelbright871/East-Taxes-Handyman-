# ---------------------------------------------------------------
# East Texas Handyman Services — environment variables
# Copy to .env and fill in for a self-hosted / external deployment.
# ---------------------------------------------------------------

# Supabase (backend, auth, storage, realtime)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im56dXFsdGx5Z2dvd3ZmbmJxd21jIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODIxODYwNywiZXhwIjoyMTAzNzk0NjA3fQ.eXaHJ0oJR_icMyTzgdiu8AjLCkXnfqNCWlYDcI96zsk"   # server-only, never expose

# AI assistant (Ranger) — Groq API, server-side only
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-20b"

# Google OAuth (sign in with Google + avatar capture)
# Set these in the Supabase Auth provider settings for the deployed project.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"
GOOGLE_REDIRECT_URI="https://your-project.supabase.co/auth/v1/callback"

# Public site URL (OAuth redirects, email links)
VITE_SITE_URL="https://your-domain.com"
